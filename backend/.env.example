# Neon: use the pooled (-pooler) host with pgbouncer=true for the running app,
# and the direct (non-pooled) host for Prisma Migrate. Never swap these two.
DATABASE_URL="postgresql://<user>:<pass>@ep-xxxx-pooler.<region>.aws.neon.tech/restaurant_inventory?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=20"
DIRECT_URL="postgresql://<user>:<pass>@ep-xxxx.<region>.aws.neon.tech/restaurant_inventory?sslmode=require"

JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:3000
EMAIL_ALERTS_ENABLED=false
CRON_LOW_STOCK_SCHEDULE="0 * * * *"
NODE_ENV=development
